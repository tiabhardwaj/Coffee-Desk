# These are environment variables. In production, set them in your host's dashboard.
# Locally, you can load this file with:  node --env-file=.env index.js   (Node 20.6+)
PORT=3001
# Where the SQLite file lives (default ./data/coffee.db)
DB_PATH=./data/coffee.db
# Production: the deployed frontend URL, no trailing slash. Comma-separate several.
CLIENT_ORIGIN=https://your-frontend.vercel.app
